# ContractFlow Python Microservice Environment Variables
# Copy this file to services/contractflow/.env and fill in real values.
# NEVER commit services/contractflow/.env or real credentials to Git.

# ─── Server ───────────────────────────────────────────────────────────────────
CONTRACTFLOW_HOST=127.0.0.1
CONTRACTFLOW_PORT=8000
CONTRACTFLOW_TIMEOUT_SECONDS=30

# ─── PostgreSQL Runtime Identity (Non-Superuser Least-Privilege Role) ─────────
# Use the dedicated `contractflow_app` database role provisioned by Migration 002.
# Do NOT use the postgres superuser or migration-owner role at runtime.
DATABASE_URL=postgresql://contractflow_app:CHANGE_ME_PASSWORD@db.your-project.supabase.co:5432/postgres

# ─── Supabase JWT & Auth Verification ─────────────────────────────────────────
# Issuer must match `{SUPABASE_URL}/auth/v1`.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
# Optional fallback key for remote `/auth/v1/user` checks
SUPABASE_ANON_KEY=your-anon-key-here

# ─── AI Provider (Groq — Disabled Until Explicitly Verified) ──────────────────
# Keep CONTRACTFLOW_ENABLE_GROQ=false until Groq credentials are verified.
# Non-AI endpoints (/register, /decisions, /status, /history) work with Groq disabled.
CONTRACTFLOW_ENABLE_GROQ=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

